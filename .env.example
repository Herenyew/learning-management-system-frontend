VITE_APP_NAME=LearnOS

# LMS backend base URL (local dev: backend runs on :4000, API prefix /api/v1)
# In Docker the vite proxy at /api/v1 -> localhost:3005 handles routing automatically.
VITE_API_BASE_URL=http://localhost:4000/api/v1

VITE_ENABLE_MOCK_DATA=true

# Auth Service URLs
VITE_AUTH_SERVICE_URL=http://localhost:3001
VITE_AUTH_FRONTEND_URL=http://localhost:5174
